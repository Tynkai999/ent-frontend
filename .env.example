# Nom de l'application
VITE_APP_NAME=ENT

# URL de l'API Backend
VITE_API_URL=/api/v1

# URL cible du proxy Vite en dev (redirige les appels /api vers le serveur backend)
VITE_DEV_API_URL=http://localhost:8001

# Configuration Keycloak (OpenID Connect / PKCE)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=ent
VITE_KEYCLOAK_CLIENT_ID=ent-frontend
